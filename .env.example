# xc-p 环境变量模板
#
# 用法：cp .env.example .env，按需改完后填写。所有键都可以留空——每项都有内置缺省值
# （括号里是代码里的实际缺省值），删掉一行等同于用缺省值。
#
# Bun 会自动加载工作目录下的 .env / .env.local / .env.<NODE_ENV>，所以不需要 dotenv。
# .env 已被 .gitignore 与 .dockerignore 排除；本文件（.env.example）允许提交。
#
# 配置入口只有两处（见 .dsh-doc/PANEL.md §D8）：
#   ① 系统级引导参数 = 本文件（下面第 1 组）；
#   ② 其余全部参数 = 面板「系统设置」落库，启动时读引导参数覆盖。

# ─────────────────────────────────────────────────────────────────────────────
# 1. 控制面启动参数（apps/server/src/config.ts）
#    这是「系统级引导参数」全集，其余配置一律进数据库，不要往这里堆。
# ─────────────────────────────────────────────────────────────────────────────

# 持久化目录：SQLite、证书、解出的 Xray、base 配置与日志都在这下面。
# 缺省 = <当前工作目录>/data。仓库根脚本的 cwd 是仓库根，所以缺省即 ./data。
# 容器里 Dockerfile 已设成 /data。
# Windows 示例：DATA_DIR=D:/xc-p/data
# DATA_DIR=./data

# 面板 + REST API 监听端口（缺省 8080）
PANEL_PORT=8080

# 面板监听地址（缺省 localhost，只监听本机）。
# 直接跑二进制保持 localhost；要让局域网/容器外访问才需要 0.0.0.0。
# Dockerfile 的运行阶段已经设成 0.0.0.0。
PANEL_HOST=localhost

# 首次启动的管理员口令（缺省 change-me-on-first-run）。
# 仅在数据库里还没有 admin 记录时生效；之后只存 argon2id 哈希，改这里不生效。
# 忘记口令用：bun run admin:password "你的新口令"（会重置并吊销全部会话）
# 务必改掉缺省值，否则面板登录页会给出一条公开可知的口令。
ADMIN_PASSWORD=

# 面板管理员用户名（缺省 admin）。同样只在首次创建账号时生效。
ADMIN_USERNAME=admin

# 会话/日志展示时区（缺省 Asia/Shanghai）。只影响展示，不影响调度语义。
TZ=Asia/Shanghai

# Xray 二进制路径（缺省 xray，即从 PATH 找）。
# 打包版自带内嵌 Xray，不需要设；源码运行时才需要，例如：
#   XRAY_BINARY=./.tools/xray            （Linux/macOS）
#   XRAY_BINARY=D:/xc-p/.tools/xray.exe  （Windows）
# 优先级：settings.xray.binary（面板里填的）> 本变量 > 内嵌 > PATH > ./.tools。
# 只有当 settings.xray.binary 还是出厂值时，本变量才会覆盖它。
# XRAY_BINARY=

# 运行环境标记（缺省 production），写入 config.env。
# Bun 也用它决定加载 .env.production 还是 .env.development，一般不用手写。
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# 2. 面板运行时调试
# ─────────────────────────────────────────────────────────────────────────────

# 面板自身日志级别：debug | info | warn | error（缺省 info）。
# 只管面板日志；Xray 进程的日志级别是 settings.xray.logLevel，在面板里改。
LOG_LEVEL=info

# 引导期设置覆盖：一份 JSON，与默认设置深合并，不写库（apps/server/src/core/settings.ts）。
# 用于测试夹具和容器引导，不影响已经落库、且在面板里改过的值。
# 例：{"gateway":{"listen":"0.0.0.0:7891"}}
# XCP_BOOTSTRAP_SETTINGS=

# ─────────────────────────────────────────────────────────────────────────────
# 3. 前端开发服务器（apps/web/src/server.ts，仅 bun run web:dev）
#    它把 /api 反代到控制面，保证浏览器同源，Cookie 会话与 SSE 才能正常工作。
# ─────────────────────────────────────────────────────────────────────────────

# 反代目标控制面地址（缺省 http://127.0.0.1:3000）。
# 控制面实际监听 8080，所以本地开发要显式指过去，否则 /api 全 502/连接失败。
# XCP_API=http://127.0.0.1:8080

# Furin 开发服务器端口（缺省 3100）
# PORT=3100

# ─────────────────────────────────────────────────────────────────────────────
# 4. 打包（scripts/build-exe.ts）
#    命令行 --target / --xray-version / --mirror 优先于这里的同名变量。
# ─────────────────────────────────────────────────────────────────────────────

# 交叉编译目标：bun-linux-x64 | bun-linux-arm64 | bun-windows-x64 |
# bun-windows-arm64 | bun-darwin-x64 | bun-darwin-arm64。
# 留空 = 当前构建机平台。
# XCP_BUILD_TARGET=

# 要内嵌的 Xray-core 发行版本（缺省 v26.3.27，见 apps/server/src/xray/release.ts）
# XRAY_VERSION=v26.3.27

# Xray 发行包下载镜像，留空走 GitHub 官方地址。GitHub 拉不动时用，例如 https://ghfast.top/
# XRAY_DOWNLOAD_MIRROR=

# ─────────────────────────────────────────────────────────────────────────────
# 5. 验收脚本（scripts/verify/*）与测试
#    需要一个真的 Xray 二进制（XRAY_BINARY，或放到 ./.tools/xray[.exe]）。
# ─────────────────────────────────────────────────────────────────────────────

# 被测控制面的基地址（缺省 http://127.0.0.1:8080）
# XCP_BASE=http://127.0.0.1:8080

# 浏览器 E2E 登录用的管理员口令（缺省空 = 跳过需要登录的用例）
# XCP_TEST_PASSWORD=

# 只有 apps/server/test/xray-render.test.ts 读它：指定渲染门禁要用的 Xray 二进制。
# 本地跑不出问题时，CI 会先 --fetch-only 下载再把路径写进这个变量。
# XRAY_BIN=

# ─────────────────────────────────────────────────────────────────────────────
# 容器部署说明（Dockerfile 运行阶段已内置，不是本文件的一部分）：
#   DATA_DIR=/data  PANEL_HOST=0.0.0.0  PANEL_PORT=8080  TZ=Asia/Shanghai
#   上面这些直接用 docker run -e 覆盖即可，镜像里内嵌了对应平台的 Xray，
#   不需要也没有意义在这里设 XRAY_BINARY。
# ─────────────────────────────────────────────────────────────────────────────
